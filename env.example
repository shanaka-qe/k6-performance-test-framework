# Example environment variables file
# Copy this to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# Environment selection (dev, sit, uat)
ENV=dev

# Base URL override (optional - will use env JSON if not set)
BASE_URL=

# Authentication credentials (keep these secret!)
CLIENT_ID=
CLIENT_SECRET=
API_KEY=

# Test execution parameters (optional overrides)
VUS=
DURATION=
RPS=

# Observability settings
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# k6 Cloud (optional)
K6_CLOUD_TOKEN=

# Output options
OUTPUT_JSON=true
OUTPUT_INFLUXDB=false
INFLUXDB_URL=

# Logging
DEBUG=false
VERBOSE=false
