{
  "description": "Common configuration shared across all environments",
  "http": {
    "timeout": "30s",
    "maxRedirects": 3,
    "userAgent": "k6-performance-test/1.0"
  },
  "thresholds": {
    "http_req_failed": {
      "threshold": "rate<0.02",
      "abortOnFail": false,
      "delayAbortEval": "10s"
    },
    "http_req_duration": {
      "p95": 800,
      "p99": 1500
    }
  },
  "tags": {
    "project": "k6-performance-framework",
    "team": "qa-performance"
  },
  "auth": {
    "tokenEndpoint": "/oauth/token",
    "refreshThreshold": 300
  },
  "retry": {
    "maxRetries": 3,
    "initialDelay": 100,
    "maxDelay": 1000,
    "backoffMultiplier": 2
  }
}

